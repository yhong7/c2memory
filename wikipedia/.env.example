WIKI_SERVICE_HOST=0.0.0.0
WIKI_SERVICE_PORT=8000
WIKI_SERVICE_CHROMA_DIR=./data/chroma
WIKI_SERVICE_COLLECTION=wiki_abstracts
WIKI_SERVICE_DEFAULT_TOP_K=10
WIKI_SERVICE_TIMEOUT_SECONDS=60
WIKI_SERVICE_WARMUP_QUERY=Albert Einstein

# Query embeddings must use the same model as the stored index.
WIKI_SERVICE_EMBED_MODE=api
EMBEDDING_API_BASE=your-embedding-base-url
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL_NAME=your-embedding-model

# Only used when WIKI_SERVICE_EMBED_MODE=local.
WIKI_SERVICE_LOCAL_EMBED_MODEL=/absolute/path/to/local-embedding-model

# Host directory mounted by docker-compose.yml.
# The default points to C2Mem's ../.db/chroma directory.
WIKI_SERVICE_CHROMA_HOST_DIR=../.db/chroma
