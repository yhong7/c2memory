# Copy this file to .env and fill only the providers you use.

# OpenAI-compatible chat endpoint
OPENAI_API_BASE=
OPENAI_API_KEY=
OPENAI_MODEL_NAME=

# Optional named profile from src/configs/configs.yaml
OPENAI_API_PROFILE_ID=

# OpenAI-compatible embedding endpoint
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=

# Optional direct overrides
OPENAI_CHAT_MAX_RETRIES=3

# C2Mem paper method. The paper does not fix these engineering values.
C2MEM_COMMITMENT_LAMBDA=0.5
C2MEM_CALIBRATION_KAPPA=1.0
C2MEM_CALIBRATION_EPSILON=1e-12
C2MEM_INJECTION_THRESHOLD=0.0
C2MEM_POSTERIOR_SAMPLES=1000
C2MEM_SPLIT_MIN_SIZE=8
C2MEM_SPLIT_SIMILARITY_THRESHOLD=0.45
C2MEM_NODE_PRIOR_ALPHA=1.0
C2MEM_NODE_PRIOR_BETA=1.0
C2MEM_UNKNOWN_PRIOR_ALPHA=1.0
C2MEM_UNKNOWN_PRIOR_BETA=1.0
C2MEM_MAX_EVENTS=1000

# User-deployed Wikipedia retrieval service
WIKI_SERVICE_URL=
WIKI_SERVICE_TIMEOUT_SECONDS=120

# Optional Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
